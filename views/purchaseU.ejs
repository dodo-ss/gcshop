<div class="container">	
	
<h2>구매 내역 수정</h2>
    <form action="#" method="post" >
        <div class="mb-3"> 
            <input class="form-control" type="hidden" name="purchase_id" placeholder="0000" value="" style = "width:300px;" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">고객</label> 
            <select name="loginid" id = "id">
                
                <option value="#"  ></option>
               
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id2">상품</label> 
            <select name="prod_id" id = "id2">
                
                <option value="#"  ></option>
                
            </select>
        </div>
        <table><tr><td>
        <div class="mb-3">
            <label class="form-label" for="id">날짜 </label> 
            <input class="form-control" type="text" name="date" value="" readonly style="width:300px;background-color:rgb(204, 203, 203);"/>
        </div></td><td>
        <div class="mb-3">
            <label class="form-label" for="id">가격 </label> 
            <input class="form-control" type="text" name="price" value=""  style="width:300px;"/>
        </div></td></tr><tr><td>
        <div class="mb-3">
            <label class="form-label" for="id">포인트 </label> 
            <input class="form-control" type="text" name="point" value="" style="width:300px;"/>
        </div></td><td>
        <div class="mb-3">
            <label class="form-label" for="id">수량 </label> 
            <input class="form-control" type="number" name="qty" value="" style="width:300px;"/>
        </div></td></tr></table>
        <div class="mb-3">
            <label class="form-label" for="id">총액 </label> 
            <input class="form-control" type="text" name="total" value="" style="width:300px;"/>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">지불여부</label> 
            <select name="payYN" id = "id">
                
                <option value="Y"  >YES</option>
                <option value="N"  >NO</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">취소여부</label> 
            <select name="cancel" id = "id">
                
                <option value="Y"  >YES</option>
                <option value="N"  >NO</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">환불여부</label> 
            <select name="refund" id = "id">
                
                <option value="Y"  >YES</option>
                <option value="N"  >NO</option>
            </select>
        </div>
        
        <button class="btn btn-outline-primary btn-sm" type="submit">수정</button>
        <a href="#"><button class="btn btn-outline-primary btn-sm" type="button">구매 목록 돌아가기</button></a>
  </form>
</div>
