<div class="container mt-4" style="max-width: 600px;">
    <h3 class="text-center mb-4">
        <%= mode === 'register' ? '회원가입' : (mode === 'create' ? '관리자 기능 : 회원생성' : '관리자 기능 : 회원수정') %>
    </h3>
    
    <form action="<%= mode === 'create' ? '/person/create_process' : '/person/update_process' %>" method="post">

        <div class="mb-3">
            <label class="form-label">ID</label>
            <input type="text" name="loginid" class="form-control" 
                value="<%= mode === 'update' ? person.loginid : '' %>"
                <%= mode === 'update' ? 'readonly' : '' %> 
                placeholder="아이디를 입력해 주세요" required>
        </div>

        <div class="mb-3">
            <label class="form-label">PW</label>
            <input type="password" name="password" class="form-control" 
                value="<%= mode === 'update' ? person.password : '' %>"
                placeholder="패스워드를 입력해 주세요" required>
        </div>

        <div class="mb-3">
            <label class="form-label">이름</label>
            <input type="text" name="name" class="form-control" 
                value="<%= mode === 'update' ? person.name : '' %>"
                placeholder="이름을 입력해 주세요" required>
        </div>

        <div class="mb-3 d-flex align-items-center">
            <label class="form-label mb-0 me-4" style="font-weight: bold;">성별</label>
            
            <div class="d-flex">
                <div class="form-check form-check-inline mb-0 me-3">
                    <input class="form-check-input" type="radio" name="mf" id="genderM" value="M" 
                        <%= (mode === 'update' && person.mf === 'M') || mode === 'create' ? 'checked' : '' %>>
                    <label class="form-check-label" for="genderM">남자</label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="radio" name="mf" id="genderF" value="F"
                        <%= (mode === 'update' && person.mf === 'F') ? 'checked' : '' %>>
                    <label class="form-check-label" for="genderF">여자</label>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">주소</label>
            <input type="text" name="address" class="form-control" 
                value="<%= mode === 'update' ? person.address : '' %>"
                placeholder="주소를 입력해 주세요">
        </div>

        <div class="mb-3">
            <label class="form-label">전화번호</label>
            <input type="text" name="tel" class="form-control" 
                value="<%= mode === 'update' ? person.tel : '' %>"
                placeholder="000-0000-0000">
        </div>

        <div class="mb-3">
            <label class="form-label">생일</label>
            <input type="text" name="birth" class="form-control" 
                value="<%= mode === 'update' ? person.birth : '' %>"
                placeholder="YYYYMMDD">
        </div>
        <div class="mb-4 d-flex align-items-center">
            <label class="form-label mb-0 me-4" style="font-weight: bold;">CLASS</label>
            
                <select name="class" class="form-select form-select-sm w-auto">
                <option value="CEO" <%= (mode === 'update' && person.class === 'CEO') ? 'selected' : '' %>>경영자</option>
                <option value="MNG" <%= (mode === 'update' && person.class === 'MNG') ? 'selected' : '' %>>관리자</option>
                <option value="CST" <%= (mode === 'update' && person.class === 'CST') || mode === 'create' ? 'selected' : '' %>>고객</option>
            </select>
        </div>
        <div class="mt-4" style="padding-left: 0;">
            <button type="submit" class="btn btn-outline-primary me-2">
                <%= mode === 'create' ? '입력' : '수정' %>
            </button>
            
            <a href="/person/view" class="btn btn-outline-primary">고객 목록 돌아가기</a>
        </div>
    </form>
</div>