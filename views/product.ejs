<div class="container mt-4">
    <h2 class="text-center mb-4">product.ejs</h2>
    
    <table class="table table-bordered align-middle text-center">
        <thead class="table-light">
            <tr>
                <th style="width: 15%;">상품</th>
                <th style="width: 50%;">상품명</th>
                <th style="width: 15%;">가격</th>
                <th style="width: 20%;">브랜드</th>
            </tr>
        </thead>
        <tbody>
            <% if (products && products.length > 0) { %>
                <% products.forEach(item => { %>
                <tr>
                    <td>
                        <a href="/detail/<%= item.prod_id %>">
                            <img src="<%= item.image %>" alt="상품이미지" style="max-height: 100px; object-fit: contain;">
                        </a>
                    </td>
                    <td>
                        <a href="/detail/<%= item.prod_id %>" style="text-decoration: none; color: black; font-weight: bold;">
                            <%= item.name %>
                        </a>
                    </td>
                    <td><%= item.price %> 원</td>
                    <td><%= item.brand %></td>
                </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4">등록된 상품이 존재하지 않습니다.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>